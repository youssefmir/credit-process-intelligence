coming></bpmn:endEvent><bpmn:userTask id="T_complete" name="Compléter la demande par téléphone"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_complete" name="Demande complète ?"><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E_cancel_completion" name="Annulée en complétion"><bpmn:incoming>F06</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="T_offer" name="Préparer et envoyer l'offre"><bpmn:incoming>F07</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask><bpmn:eventBasedGateway id="G_wait" name=""><bpmn:incoming>F16</bpmn:incoming><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="E_new_offer" name="Nouvelle offre demandée"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:messageEventDefinition id="E_new_offer_med" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="E_back" name="Offre signée reçue"><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:messageEventDefinition id="E_back_med" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="E_timer" name="Pas de retour à la date prévue"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:timerEventDefinition id="E_timer_ted" /></bpmn:intermediateCatchEvent><bpmn:userTask id="T_followup" name="Relancer le client"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:standardLoopCharacteristics /></bpmn:userTask><bpmn:exclusiveGateway id="G_expired" name="Offre expirée (30 jours) ?"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E_cancel_expired" name="Annulée f