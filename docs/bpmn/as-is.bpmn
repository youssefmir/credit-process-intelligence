nnotation id="A5"><bpmn:text>Seuls 35 % des prêts approuvés suivent le chemin nominal sans reprise</bpmn:text></bpmn:textAnnotation><bpmn:association id="A5_assoc" sourceRef="E_activated" targetRef="A5" /></bpmn:process>
