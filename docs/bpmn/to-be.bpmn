</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E_cancel_expired" name="Annulée faute de retour"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="T_validate" name="Valider le dossier (décision humaine)"><bpmn:incoming>F21</bpmn:incoming><bpmn:incoming>F17b</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_docs" name="Dossier complet ?"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T_missing" name="Relancer pour pièces manquantes"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:standardLoopCharacteristics /></bpmn:userTask><bpmn:intermediateCatchEvent id="E_docs" name="Pièces reçues"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:messageEventDefinition id="E_docs_med" /></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="G_decision" name="Décision"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T_activate" name="Enregistrer et activer le prêt"><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_activated" name="Prêt activé"><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="E_declined" name="Refusée après examen"><bpmn:incoming>F25</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="T_ai_check" name="Contrôler la complétude et lire les pièces (IA)"><bpmn:incoming>F04a</bpmn:incoming><bpmn:outgoing>F04b</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T_ai_score" name="Calculer le risque d'abandon (pilote)"><bpmn:incoming>F08a</bpmn:incoming><bpmn:outgoing>F08b</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T_ai_brief" name="Préparer la fiche de pré-analyse (IA)"><bpmn:incoming>F17a</bpmn:incoming><bpmn:outgoing>F17b</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="T_precheck" /><bpmn:sequenceFlow id="F02" sourceRef="T_precheck" targetRef="G_eligible" /><bpmn:sequenceFlow id="F03" name="non" sourceRef="G_eligible" targetRef="E_declined_auto" /><bpmn:sequenceFlow id="F05" sourceRef="T_complete" targetRef="G_complete" /><bpmn:sequenceFlow id="F06" name="abandon" sourceRef="G_complete" targetRef="E_cancel_completion" /><bpmn:sequenceFlow id="F07" name="oui" sourceRef="G_complete" targetRef="T_offer" /><bpmn:sequenceFlow id="F09" sourceRef="G_wait" targetRef="E_back" /><bpmn:sequenceFlow id="F10" sourceRef="G_wait" targetRef="E_timer" /><bpmn:sequenceFlow id="F11" sourceRef="G_wait" targetRef="E_new_offer" /><bpmn:sequenceFlow id="F12" sourceRef="E_new_offer" targetRef="T_offer" /><bpmn:sequenceFlow id="F13" sourceRef="E_timer" targetRef="T_followup" /><bpmn:sequenceFlow id="F14" sourceRef="T_followup" targetRef="G_expired" /><bpmn:sequenceFlow id="F15" name="oui" sourceRef="G_expired" targetRef="E_cancel_expired" /><bpmn:sequenceFlow id="F16" name="non" sourceRef="G_expired" targetRef="G_wait" /><bpmn:sequenceFlow id="F18" sourceRef="T_validate" targetRef="G_docs" /><bpmn:sequenceFlow id="F19" name="non" sourceRef="G_docs" targetRef="T_missing" /><bpmn:sequenceFlow id="F20" sourceRef="T_missing" targetRef="E_docs" /><bpmn:sequenceFlow id="F21" sourceRef="E_docs" targetRef="T_validate" /><bpmn:sequenceFlow id="F22" name="oui" sourceRef="G_docs" targetRef="G_decision" /><bpmn:sequenceFlow id="F23" name="accord" sourceRef="G_decision" targetRef="T_activate" /><bpmn:sequenceFlow id="F24" sourceRef="T_activate" targetRef="E_activated" /><bpmn:sequenceFlow id="F25" name="refus" sourceRef="G_decision" targetRef="E_declined" /><bpmn:sequenceFlow id="F04a" name="oui" sourceRef="G_eligible" targetRef="T_ai_check" /><bpmn:sequenceFlow id="F04b" sourceRef="T_ai_check" targetRef="T_complete" /><bpmn:sequenceFlow id="F08a" sourceRef="T_offer" targetRef="T_ai_score" /><bpmn:sequenceFlow id="F08b" sourceRef="T_ai_score" targetRef="G_wait" /><bpmn:sequenceFlow id="F17a" sourceRef="E_back" targetRef="T_ai_brief" /><bpmn:sequenceFlow id="F17b" sourceRef="T_ai_brief" targetRef="T_validate" /><bpmn:textAnnotation id="A1"><bpmn:text>58 % des demandes refusées, le plus souvent en moins d'une heure</bpmn:text></bpmn:textAnnotation><bpmn:association id="A1_assoc" sourceRef="E_declined_auto" targetRef="A1" /><bpmn:textAnnotation id="A3"><bpmn:text>35 % des offres envoyées finissent annulées, dont 36 % à l'expiration des 30 jours</bpmn:text></bpmn:textAnnotation><bpmn:association id="A3_assoc" sourceRef="E_cancel_expired" targetRef="A3" /><bpmn:textAnnotation id="A4"><bpmn:text>Boucle « dossier incomplet » : 51 % des dossiers validés</bpmn:text></bpmn:textAnnotation><bpmn:association id="A4_assoc" sourceRef="T_missing" targetRef="A4" /><bpmn:textAnnotation id="B1"><bpmn:text>Pièces vérifiées dès le dépôt : moins de boucles « incomplet » et d'appels de complétion (hypothèses chiffrées)</bpmn:text></bpmn:textAnnotation><bpmn:association id="B1_assoc" sourceRef="T_ai_check" targetRef="B1" /><bpmn:textAnnotation id="B2"><bpmn:text>Pilote A/B d'abord : le score actuel (ROC-AUC 0,56) ne passe pas les seuils</bpmn:text></bpmn:textAnnotation><bpmn:association id="B2_assoc" sourceRef="T_ai_score" targetRef="B2" /><bpmn:textAnnotation id="B3"><bpmn:text>Aucune décision automatisée : l'analyste relit la fiche, la corrige et décide</bpmn:text></bpmn:textAnnotation><bpmn:association id="B3_assoc" sourceRef="T_ai_brief" targetRef="B3" /></bpmn:process>
